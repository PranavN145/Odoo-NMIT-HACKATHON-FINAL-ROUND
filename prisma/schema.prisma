
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------
// ENUMS
// ------------------------------------------------------

enum Role {
  ADMIN
  MEMBER
}

enum MembershipStatus {
  PENDING
  ACTIVE
  EXPIRED
  REJECTED
}

enum TicketStatus {
  RESERVED
  PAID
  CANCELLED
  CHECKED_IN
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionCategory {
  MEMBERSHIP_DUE
  TICKET_SALE
  MERCHANDISE_SALE
  EVENT_EXPENSE
  REIMBURSEMENT
  OTHER
}

enum AnnouncementAudience {
  ALL
  MEMBERS
  VOLUNTEERS
}

enum ReimbursementStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

// ------------------------------------------------------
// 4.1 USER ACCOUNTS AND ROLE-BASED PERMISSIONS
// ------------------------------------------------------

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String
  phone        String?
  role         Role     @default(MEMBER)
  isVolunteer  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships            Membership[]
  tickets                Ticket[]
  orders                 Order[]
  assignedTasks          VolunteerTask[] @relation("AssignedTasks")
  announcements          Announcement[]  @relation("PublishedAnnouncements")
  transactions           Transaction[]   @relation("RecordedTransactions")
  reimbursements         Reimbursement[] @relation("ApplicantReimbursements")
  approvedReimbursements Reimbursement[] @relation("ApprovedReimbursements")
}

// ------------------------------------------------------
// 4.2 MEMBERSHIPS
// ------------------------------------------------------

model Membership {
  id            String           @id @default(uuid()) @db.Uuid
  userId        String           @db.Uuid
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  durationYears Int              @default(1)
  startDate     DateTime
  expiryDate    DateTime
  amountPaid    Decimal          @db.Decimal(10, 2)
  status        MembershipStatus @default(PENDING)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  transaction Transaction?
}

// ------------------------------------------------------
// 4.3 EVENTS
// ------------------------------------------------------

model Event {
  id            String   @id @default(uuid()) @db.Uuid
  title         String
  description   String
  date          DateTime
  venue         String
  capacity      Int
  memberPrice   Decimal  @db.Decimal(10, 2)
  standardPrice Decimal  @db.Decimal(10, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tickets Ticket[]
  tasks   VolunteerTask[]
}

// ------------------------------------------------------
// 4.4 EVENT TICKETS
// ------------------------------------------------------

model Ticket {
  id                   String       @id @default(uuid()) @db.Uuid
  eventId              String       @db.Uuid
  event                Event        @relation(fields: [eventId], references: [id], onDelete: Restrict)
  userId               String       @db.Uuid
  user                 User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticketCode           String       @unique
  pricePaid            Decimal      @db.Decimal(10, 2)
  status               TicketStatus @default(RESERVED)
  checkedInAt          DateTime?
  reservationExpiresAt DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  transaction Transaction?

  // One ticket per user per event
  @@unique([eventId, userId])
}

// ------------------------------------------------------
// 4.5 MERCHANDISE PRODUCTS
// ------------------------------------------------------

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  basePrice   Decimal  @db.Decimal(10, 2)
  imageUrl    String?
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  variants ProductVariant[]
}

// ------------------------------------------------------
// 4.6 PRODUCT VARIANTS AND INVENTORY
// ------------------------------------------------------

model ProductVariant {
  id            String   @id @default(uuid()) @db.Uuid
  productId     String   @db.Uuid
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  size          String
  stockQuantity Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orderItems OrderItem[]

  // A product cannot have duplicate variants of the same size
  @@unique([productId, size])
}

// ------------------------------------------------------
// 4.7 MERCHANDISE ORDERS
// ------------------------------------------------------

model Order {
  id                   String      @id @default(uuid()) @db.Uuid
  userId               String      @db.Uuid
  user                 User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalAmount          Decimal     @db.Decimal(10, 2)
  status               OrderStatus @default(PENDING)
  reservationExpiresAt DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  orderItems   OrderItem[]
  transaction  Transaction?
}

// ------------------------------------------------------
// 4.8 ORDER ITEMS
// ------------------------------------------------------

model OrderItem {
  id        String         @id @default(uuid()) @db.Uuid
  orderId   String         @db.Uuid
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId String         @db.Uuid
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  quantity  Int
  unitPrice Decimal        @db.Decimal(10, 2)
}

// ------------------------------------------------------
// 4.9 VOLUNTEER TASKS
// ------------------------------------------------------

model VolunteerTask {
  id          String     @id @default(uuid()) @db.Uuid
  title       String
  description String
  assigneeId  String?    @db.Uuid
  assignee    User?      @relation("AssignedTasks", fields: [assigneeId], references: [id], onDelete: SetNull)
  eventId     String?    @db.Uuid
  event       Event?     @relation(fields: [eventId], references: [id], onDelete: SetNull)
  deadline    DateTime?
  status      TaskStatus @default(PENDING)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

// ------------------------------------------------------
// 4.10 ANNOUNCEMENTS
// ------------------------------------------------------

model Announcement {
  id            String               @id @default(uuid()) @db.Uuid
  title         String
  content       String
  audience      AnnouncementAudience @default(ALL)
  publishedById String               @db.Uuid
  publishedBy   User                 @relation("PublishedAnnouncements", fields: [publishedById], references: [id])
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
}

// ------------------------------------------------------
// 4.11 FINANCIAL TRANSACTIONS
// ------------------------------------------------------

model Transaction {
  id              String              @id @default(uuid()) @db.Uuid
  idempotencyKey  String              @unique
  type            TransactionType
  category        TransactionCategory
  amount          Decimal             @db.Decimal(10, 2)
  description     String
  recordedById    String              @db.Uuid
  recordedBy      User                @relation("RecordedTransactions", fields: [recordedById], references: [id])

  orderId         String?             @unique @db.Uuid
  order           Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)

  ticketId        String?             @unique @db.Uuid
  ticket          Ticket?             @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  membershipId    String?             @unique @db.Uuid
  membership      Membership?          @relation(fields: [membershipId], references: [id], onDelete: SetNull)

  reimbursementId String?             @unique @db.Uuid
  reimbursement   Reimbursement?       @relation(fields: [reimbursementId], references: [id], onDelete: SetNull)

  createdAt       DateTime            @default(now())
}

// ------------------------------------------------------
// 4.12 REIMBURSEMENTS
// ------------------------------------------------------

model Reimbursement {
  id           String              @id @default(uuid()) @db.Uuid
  applicantId  String              @db.Uuid
  applicant    User                @relation("ApplicantReimbursements", fields: [applicantId], references: [id], onDelete: Cascade)
  amount       Decimal             @db.Decimal(10, 2)
  reason       String
  receiptUrl   String?
  status       ReimbursementStatus @default(PENDING)
  approvedById String?             @db.Uuid
  approvedBy   User?               @relation("ApprovedReimbursements", fields: [approvedById], references: [id])
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  transaction Transaction?
}
