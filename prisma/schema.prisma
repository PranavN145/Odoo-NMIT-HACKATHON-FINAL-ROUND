// Prisma Schema for Student Organization System
// Conforming strictly to Docx/schema.md (MongoDB Atlas / Prisma)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------
// ENUMS (Standardized Status, Roles & Audiences)
// ------------------------------------------------------

enum Role {
  ADMIN
  MEMBER
}

enum MembershipStatus {
  PENDING
  ACTIVE
  EXPIRED
  REJECTED
}

enum TicketStatus {
  RESERVED
  PAID
  CANCELLED
  CHECKED_IN
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionCategory {
  MEMBERSHIP_DUE
  TICKET_SALE
  MERCHANDISE_SALE
  EVENT_EXPENSE
  REIMBURSEMENT
  OTHER
}

enum AnnouncementAudience {
  ALL
  MEMBERS
  VOLUNTEERS
}

enum ReimbursementStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

// ------------------------------------------------------
// MODELS (12 Core Entities per schema.md)
// ------------------------------------------------------

/// 4.1 User accounts and role-based permissions
model User {
  id           String   @id @default(uuid()) @map("_id")
  name         String
  email        String   @unique
  passwordHash String
  phone        String?
  role         Role     @default(MEMBER)
  isVolunteer  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  memberships            Membership[]
  tickets                Ticket[]
  orders                 Order[]
  assignedTasks          VolunteerTask[]  @relation("AssignedTasks")
  announcements          Announcement[]   @relation("PublishedAnnouncements")
  transactions           Transaction[]    @relation("RecordedTransactions")
  reimbursements         Reimbursement[]  @relation("ApplicantReimbursements")
  approvedReimbursements Reimbursement[] @relation("ApprovedReimbursements")
}

/// 4.2 Membership subscriptions, validity, and duration
model Membership {
  id            String           @id @default(uuid()) @map("_id")
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  durationYears Int              @default(1)
  startDate     DateTime
  expiryDate    DateTime
  amountPaid    Float
  status        MembershipStatus @default(PENDING)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  // Relations
  transactions Transaction[]
}

/// 4.3 Events, capacity limits, and pricing tiers
model Event {
  id            String   @id @default(uuid()) @map("_id")
  title         String
  description   String
  date          DateTime
  venue         String
  capacity      Int
  memberPrice   Float
  standardPrice Float
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  tickets Ticket[]
  tasks   VolunteerTask[]
}

/// 4.4 Event ticket reservations, verification codes, and check-in
model Ticket {
  id                   String       @id @default(uuid()) @map("_id")
  eventId              String
  event                Event        @relation(fields: [eventId], references: [id], onDelete: Restrict)
  userId               String
  user                 User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticketCode           String       @unique
  pricePaid            Float
  status               TicketStatus @default(RESERVED)
  checkedInAt          DateTime?
  reservationExpiresAt DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  // Relations
  transactions Transaction[]

  // Constraint: One ticket per user per event
  @@unique([eventId, userId])
}

/// 4.5 Merchandise catalogue items
model Product {
  id          String   @id @default(uuid()) @map("_id")
  name        String
  basePrice   Float
  imageUrl    String?
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  variants ProductVariant[]
}

/// 4.6 Size-level stock inventory for merchandise (e.g. S, M, L, XL)
model ProductVariant {
  id            String   @id @default(uuid()) @map("_id")
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  size          String
  stockQuantity Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  orderItems OrderItem[]

  // Constraint: Unique combination of productId and size
  @@unique([productId, size])
}

/// 4.7 Customer merchandise orders
model Order {
  id                   String      @id @default(uuid()) @map("_id")
  userId               String
  user                 User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalAmount          Float
  status               OrderStatus @default(PENDING)
  reservationExpiresAt DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  // Relations
  orderItems   OrderItem[]
  transactions Transaction[]
}

/// 4.8 Individual items inside a merchandise order
model OrderItem {
  id        String         @id @default(uuid()) @map("_id")
  orderId   String
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  quantity  Int
  unitPrice Float
}

/// 4.9 Volunteer task assignments and progress tracking
model VolunteerTask {
  id          String     @id @default(uuid()) @map("_id")
  title       String
  description String
  assigneeId  String?
  assignee    User?      @relation("AssignedTasks", fields: [assigneeId], references: [id], onDelete: SetNull)
  eventId     String?
  event       Event?     @relation(fields: [eventId], references: [id], onDelete: SetNull)
  deadline    DateTime?
  status      TaskStatus @default(PENDING)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

/// 4.10 Targeted organization announcements
model Announcement {
  id            String               @id @default(uuid()) @map("_id")
  title         String
  content       String
  audience      AnnouncementAudience @default(ALL)
  publishedById String
  publishedBy   User                 @relation("PublishedAnnouncements", fields: [publishedById], references: [id])
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
}

/// 4.11 Central traceable financial ledger (income & expenses)
model Transaction {
  id              String              @id @default(uuid()) @map("_id")
  idempotencyKey  String              @unique
  type            TransactionType
  category        TransactionCategory
  amount          Float
  description     String
  recordedById    String
  recordedBy      User                @relation("RecordedTransactions", fields: [recordedById], references: [id])
  orderId         String?
  order           Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  ticketId        String?
  ticket          Ticket?             @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  membershipId    String?
  membership      Membership?         @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  reimbursementId String?
  reimbursement   Reimbursement?      @relation(fields: [reimbursementId], references: [id], onDelete: SetNull)
  createdAt       DateTime            @default(now())
}

/// 4.12 Volunteer expense reimbursement claims
model Reimbursement {
  id           String              @id @default(uuid()) @map("_id")
  applicantId  String
  applicant    User                @relation("ApplicantReimbursements", fields: [applicantId], references: [id], onDelete: Cascade)
  amount       Float
  reason       String
  receiptUrl   String?
  status       ReimbursementStatus @default(PENDING)
  approvedById String?
  approvedBy   User?               @relation("ApprovedReimbursements", fields: [approvedById], references: [id])
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  // Relations
  transactions Transaction[]
}
